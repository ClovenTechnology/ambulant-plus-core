model CarePortPharmacySku {
  id                   String  @id @default(cuid())
  orgId                String  @default("org-default")
  pharmacyId           String
  name                 String
  drugCode             String?
  skuCode              String?
  isGeneric            Boolean @default(false)
  // Universal CarePort catalogue classification.
  // Supports prescription medicines, OTC items and general pharmacy merchandise.
  productType          String  @default("MEDICATION") @db.VarChar(60)
  category             String? @db.VarChar(120)
  subcategory          String? @db.VarChar(120)
  otc                  Boolean @default(false)
  prescriptionRequired Boolean @default(true)
  marketplaceVisible   Boolean @default(false)
  sellableOnline       Boolean @default(true)

  // Retail merchandising and catalogue enrichment.
  brand        String? @db.VarChar(160)
  manufacturer String? @db.VarChar(160)
  barcode      String? @db.VarChar(120)
  description  String?
  imageUrl     String?
  packSize     String? @db.VarChar(120)

  // Variant support for size, colour, flavour, strength, bundle size, etc.
  variantGroupKey   String? @db.VarChar(160)
  variantName       String? @db.VarChar(160)
  variantAttributes Json?
  attributes        Json?

  // Stock and retail guardrails.
  stockOnHand             Int?
  reservedStock           Int       @default(0)
  lowStockThreshold       Int?
  maxOrderQty             Int?
  ageRestricted           Boolean   @default(false)
  regulatedSchedule       String?   @db.VarChar(80)
  taxCategory             String?   @db.VarChar(80)
  // Catalogue normalisation and governance.
  catalogueSource         String    @default("PHARMACY_SUPPLIED") @db.VarChar(80)
  normalisationStatus     String    @default("RAW_PHARMACY_SUPPLIED") @db.VarChar(80)
  normalisationConfidence Float?
  normalisationNotes      String?
  globalProductKey        String?   @db.VarChar(180)
  globalProductId         String?   @db.VarChar(191)
  canonicalName           String?   @db.VarChar(500)
  customAttributeValues   Json?
  normalisedAttributes    Json?
  reviewRequired          Boolean   @default(false)
  reviewReason            String?
  reviewedBy              String?
  reviewedAt              DateTime?

  priceCents Int
  currency   String          @default("ZAR")
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  pharmacy   PharmacyPartner @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, isActive])
  @@index([pharmacyId, drugCode])
  @@index([pharmacyId, productType, isActive])
  @@index([pharmacyId, category, isActive])
  @@index([pharmacyId, otc, marketplaceVisible])
  @@index([pharmacyId, prescriptionRequired, isActive])
  @@index([barcode])
  @@index([variantGroupKey])
  @@index([catalogueSource])
  @@index([normalisationStatus, reviewRequired])
  @@index([reviewRequired, updatedAt])
  @@index([globalProductKey])
  @@index([globalProductId])
  @@index([canonicalName])
  @@index([orgId])
}

