model ShopVariant {
  id                String                  @id @default(cuid())
  productId         String
  sku               String                  @unique
  label             String
  active            Boolean                 @default(true)
  unitAmountZar     Int
  saleUnitAmountZar Int?
  imageUrl          String?
  inStock           Boolean                 @default(true)
  stockQty          Int?
  allowBackorder    Boolean?
  orgId             String                  @default("org-default")
  meta              Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  movements         ShopInventoryMovement[]
  product           ShopProduct             @relation(fields: [productId], references: [id], onDelete: Cascade)
  channels          ShopVariantChannel[]

  @@index([productId])
  @@index([orgId])
  @@index([active])
  @@index([inStock])
}

model ShopProductChannel {
  id        String      @id @default(cuid())
  productId String
  channel   ShopChannel
  orgId     String      @default("org-default")
