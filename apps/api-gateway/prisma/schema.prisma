// ============================================================
// A5-K-C-B â€” Enterprise Finance Schema Foundation
// A5_K_C_B_ENTERPRISE_FINANCE_SCHEMA_FOUNDATION
// ============================================================
// This schema foundation separates:
// - staff payroll / payslips / salary arrears
// - commission events and awards
// - platform revenue and manual capital inflows
// - cap table, shareholder registry and investor relations
//
// Intentionally uses scalar foreign-key fields rather than hard Prisma
// relations so this foundation can be introduced without disturbing
// existing auth/user/provider models while the operational APIs are built.

model StaffPayrollProfile {
  id               String  @id @default(cuid())
  staffUserId      String
  staffDisplayName String?
  staffEmail       String?
  staffRole        String? @db.VarChar(120)
  departmentId     String?
  designationId    String?

  employmentType String @default("permanent") @db.VarChar(80)
  payrollStatus  String @default("draft") @db.VarChar(80)
  country        String @default("ZA") @db.VarChar(2)
  currency       String @default("ZAR") @db.VarChar(3)

  baseSalaryCents       Int      @default(0)
  hourlyRateCents       Int      @default(0)
  defaultHoursPerPeriod Decimal? @db.Decimal(10, 2)
  payFrequency          String   @default("monthly") @db.VarChar(80)

  commissionEligible Boolean @default(false)
  commissionMode     String  @default("none") @db.VarChar(80)

  taxNumber         String?
  payrollNumber     String?
  employerReference String?
  startDate         DateTime?
  endDate           DateTime?

  profileMeta      Json?
  payrollMeta      Json?
  approvalStatus   String    @default("pending") @db.VarChar(80)
  approvedByUserId String?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffUserId])
  @@index([staffEmail])
  @@index([employmentType])
  @@index([payrollStatus])
  @@index([approvalStatus])
  @@index([departmentId, designationId])
}

model StaffBankAccount {
  id               String  @id @default(cuid())
  staffUserId      String
  payrollProfileId String?

  accountHolderName      String?
  bankName               String?
  bankCode               String?
  branchCode             String?
  accountNumberMasked    String?
  accountNumberEncrypted String?
  accountType            String? @db.VarChar(80)
  country                String  @default("ZA") @db.VarChar(2)
  currency               String  @default("ZAR") @db.VarChar(3)

  paystackRecipientCode String?
  verificationStatus    String    @default("unverified") @db.VarChar(80)
  verificationProvider  String?
  verifiedAt            DateTime?

  isPrimary Boolean @default(false)
  active    Boolean @default(true)

  meta            Json?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([staffUserId])
  @@index([payrollProfileId])
  @@index([verificationStatus])
  @@index([active])
}

model PayrollPeriod {
