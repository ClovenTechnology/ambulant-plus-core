model Client {
  id    String @id @default(cuid())
  orgId String @default("org-default")

  type   ClientType
  status ClientStatus @default(DRAFT)

  legalName   String
  tradingName String?
  code        String? @unique

  billingMode ClientBillingMode @default(HYBRID)

  defaultCurrency String  @default("ZAR") @db.VarChar(3)
  country         String? @db.VarChar(2)

  allowsClaims        Boolean @default(true)
  allowsWalletFunding Boolean @default(true)
  allowsHybridFunding Boolean @default(true)

  contractStartAt  DateTime?
  contractEndAt    DateTime?
  paymentTermsDays Int       @default(30)

  contactsJson Json?
  configJson   Json?
  metadata     Json?

  claimsSubmissionMode ClaimsSubmissionMode @default(MANUAL_REVIEW)
  eligibilityMode      EligibilityMode      @default(UPLOAD)

  supportsTelevisit Boolean @default(true)
  supportsInPerson  Boolean @default(true)

  requiresConsentForClaims  Boolean @default(false)
  requiresConsentForVitals  Boolean @default(true)
  requiresConsentForReports Boolean @default(true)

  apiBaseUrl   String?
  contactEmail String?
  contactPhone String?

  payerMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs                   ClientProgram[]
  members                    ClientMember[]
  coveragePlans              CoveragePlan[]
  authorizations             CoverageAuthorization[]
  billableEvents             BillableEvent[]
  claims                     ClientClaim[]
  settlements                SettlementRecord[]
  wallet                     ClientWalletAccount?
  consentPolicies            ClientConsentPolicy[]
  consentGrants              ClientConsentGrant[]
  sponsorContracts           ClinicianClientContract[]
  devicePrograms             SponsoredDeviceProgram[]
  sponsoredDeviceAssignments SponsoredDeviceAssignment[]

  @@index([orgId, type, status])
  @@index([orgId, legalName])
}

model ClientProgram {
  id    String @id @default(cuid())
  orgId String @default("org-default")

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      ClientProgramStatus @default(DRAFT)

  startAt DateTime?
  endAt   DateTime?

  billingModeOverride ClientBillingMode?
  metadata            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coveragePlans CoveragePlan[]
  members       ClientMember[]

  @@unique([clientId, name])
  @@index([orgId, clientId, status])
}

model CoveragePlan {
  id    String @id @default(cuid())
  orgId String @default("org-default")

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  clientProgramId String?
  clientProgram   ClientProgram? @relation(fields: [clientProgramId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      CoverageStatus @default(DRAFT)

  currency String @default("ZAR") @db.VarChar(3)

  annualLimitMinor   Int?
  monthlyLimitMinor  Int?
  lifetimeLimitMinor Int?

  requiresEligibility Boolean @default(true)
  requiresConsent     Boolean @default(true)

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceRules   CoverageServiceRule[]
  members        ClientMember[]
  authorizations CoverageAuthorization[]
  ClientClaim    ClientClaim[]

  @@unique([clientId, name])
  @@index([orgId, clientId, status])
  @@index([clientProgramId])
}

model CoverageServiceRule {
  id    String @id @default(cuid())
  orgId String @default("org-default")

  coveragePlanId String
  coveragePlan   CoveragePlan @relation(fields: [coveragePlanId], references: [id], onDelete: Cascade)

  serviceType CoveredServiceType

  enabled Boolean @default(true)

  decision CoverageDecision @default(COVERED)

  sponsorCapMinor    Int?
  memberCopayMinor   Int?
  memberCopayPercent Decimal? @db.Decimal(5, 2)

  preauthRequired Boolean @default(false)

  limitCount  Int?
  limitMinor  Int?
  limitPeriod CoverageLimitPeriod?

  allowedVisitModes String[] @default([])
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([coveragePlanId, serviceType])
  @@index([orgId, serviceType, enabled])
}

model ClientMember {
  id    String @id @default(cuid())
  orgId String @default("org-default")

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  clientProgramId String?
  clientProgram   ClientProgram? @relation(fields: [clientProgramId], references: [id], onDelete: SetNull)

  coveragePlanId String?
  coveragePlan   CoveragePlan? @relation(fields: [coveragePlanId], references: [id], onDelete: SetNull)

  userId    String?
  patientId String?

  memberKind   ClientMemberKind
  memberStatus ClientMemberStatus @default(PENDING)

  memberNumber          String?
  employeeNumber        String?
  dependentCode         String?
  principalMemberNumber String?

  joinedAt      DateTime?
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  source            ClientMemberSource       @default(PATIENT_SELF_LINK)
  verificationState ClientMemberVerification @default(PENDING)

  eligibilityStatus       String?
  eligibilityPeriodKey    String?
  premiumStatus           String?
  lastEligibilityCheckAt  DateTime?
  verifiedUntil           DateTime?
  eligibilityReason       String?
  verificationSource      String?
  verificationPayloadHash String?

  televisitEligible Boolean @default(true)
  inPersonEligible  Boolean @default(true)

  principalMemberName String?
  relationship        String?

  payerPayload Json?
  notes        String?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorizations             CoverageAuthorization[]
  billableEvents             BillableEvent[]
  sponsoredDeviceAssignments SponsoredDeviceAssignment[]
  claimConsents              ClientMemberConsent[]
  claims                     ClientClaim[]

  @@unique([clientId, memberNumber, dependentCode])
  @@index([orgId, clientId, memberStatus])
  @@index([userId])
  @@index([patientId])
  @@index([coveragePlanId])
  @@index([employeeNumber])
  @@index([memberNumber])
}

model ClientMemberEligibilitySnapshot {
