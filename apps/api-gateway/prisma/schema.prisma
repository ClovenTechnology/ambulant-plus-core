model ClinicianOnboarding {
  id             String    @id @default(cuid())
  clinicianId    String    @unique
  status         String    @default("pending")
  paymentPlan    String?
  depositPaid    Boolean   @default(false)
  nextPaymentAt  DateTime?
  trainingSlotId String?
  trainingMode   String?
  trainingNotes  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  dispatches       ClinicianDispatch[]
  payments         ClinicianOnboardingPayment[]
  payLaterRequests ClinicianOnboardingPayLaterRequest[]
  trainingSlot     ClinicianTrainingSlot?               @relation(fields: [trainingSlotId], references: [id])

  @@index([status])
}

model ClinicianOnboardingPayLaterRequest {
  id           String @id @default(cuid())
  clinicianId  String
  onboardingId String

  pathwayKey String @default("START_NOW_PAY_LATER")
  status     String @default("pending") // pending | approved | rejected | withdrawn | cancelled

  requestReason     String?
  requestedByUserId String?
  requestedAt       DateTime @default(now())

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?

  // Set while the request is active and cleared when reviewed or withdrawn.
  // The nullable unique value prevents duplicate active requests while preserving history.
  activeRequestKey String? @unique

  approvalPaymentId String?
  meta              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboarding ClinicianOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([clinicianId, status, requestedAt])
  @@index([onboardingId, requestedAt])
  @@index([status, requestedAt])
  @@index([reviewedAt])
  @@index([approvalPaymentId])
}

model ClinicianOnboardingPayment {
  id String @id @default(cuid())

  clinicianId  String
  onboardingId String

  amountCents Int
  currency    String @default("ZAR")

  provider String // paystack | eft | manual | internal
  status   String @default("pending") // pending | confirmed | captured | failed | cancelled | redeemed

  providerReference String?   @unique
  paymentReference  String?
  payerName         String?
  originBank        String?
  paymentDate       DateTime?
  proofOfPaymentUrl String?

  authorisationCodeHash  String?   @unique
  authorisationCodeHint  String?
  authorisationExpiresAt DateTime?
  authorisationUsedAt    DateTime?

  confirmedByUserId String?
  confirmedAt       DateTime?

  meta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboarding ClinicianOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([clinicianId])
  @@index([onboardingId])
  @@index([status])
  @@index([provider])
  @@index([paymentReference])
  @@index([confirmedAt])
}

model ClinicianOnboardingSetting {
  id String @id @default("default")

  trainingFeeCents           Int     @default(0)
  minimumInitialPaymentCents Int     @default(0)
  allowPartialPayment        Boolean @default(false)
  balanceRecoveryMode        String  @default("manual") // manual | payout_deduction | disabled
  balanceRecoveryNotes       String?
  currency                   String  @default("ZAR") @db.VarChar(3)
  paymentProvider            String  @default("paystack")

  cardPaymentEnabled   Boolean @default(true)
  manualPaymentEnabled Boolean @default(true)

  starterKitItems        Json?
  starterKitDepositItems Json?
  bankInstructions       Json?
  commercialPathways     Json?
  trainingPolicy         Json?
  notes                  String?

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentProvider])
  @@index([cardPaymentEnabled])
  @@index([manualPaymentEnabled])
}

model ClinicianTrainingSlot {
  id                     String                                   @id @default(cuid())
  title                  String                                   @default("Mandatory Clinician Training")
  summary                String?
  status                 String                                   @default("draft")
  startsAt               DateTime
  endsAt                 DateTime
  timezone               String                                   @default("Africa/Johannesburg")
  durationDays           Int                                      @default(1)
  totalDurationMinutes   Int                                      @default(60)
  capacity               Int                                      @default(1)
  usedCount              Int                                      @default(0)
  mode                   String                                   @default("virtual")
  allowedModes           Json?
  sessions               Json?
  meetingUrl             String?
  trainerName            String?
  venueName              String?
  venueAddress           String?
  virtualInstructions    String?
  inPersonInstructions   String?
  bookingOpensAt         DateTime?
  bookingClosesAt        DateTime?
  publishedAt            DateTime?
  publishedByUserId      String?
  cancelledAt            DateTime?
  cancelledByUserId      String?
