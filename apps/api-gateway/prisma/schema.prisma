  @@index([sku])
  @@index([orgId])
}

model Department {
  id           String             @id @default(cuid())
  name         String             @unique
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  adminUsers   AdminUserProfile[]
  designations Designation[]
  roleRequests RoleRequest[]
}

model Designation {
  id           String             @id @default(cuid())
  departmentId String
  name         String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  adminUsers   AdminUserProfile[]
  department   Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roles        DesignationRole[]
  roleRequests RoleRequest[]

  @@unique([departmentId, name])
}

model Role {
  id               String            @id @default(cuid())
  name             String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  designationLinks DesignationRole[]
  roleRequestRoles RoleRequestRole[]
  scopes           RoleScope[]
  userRoles        UserRole[]
}

model RoleScope {
  roleId String
  scope  String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, scope])
  @@index([scope])
}

model DesignationRole {
  designationId String
  roleId        String
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([designationId, roleId])
  @@index([roleId])
}

model AdminUserProfile {
  id                     String                           @id @default(cuid())
  userId                 String                           @unique
  email                  String                           @unique
  name                   String?
  phone                  String?                          @db.VarChar(40)
  staffIdentifier        String?                          @unique @db.VarChar(120)
  photoUrl               String?
  departmentId           String?
  designationId          String?
  managerId              String?
  lifecycleState         AdminStaffLifecycleState         @default(ACTIVE)
  lifecycleChangedAt     DateTime?
  lifecycleChangedBy     String?
  lifecycleReason        String?
  timezone               String?                          @db.VarChar(120)
  workingHours           Json?
  preferredContactMethod AdminStaffPreferredContactMethod?
  lastActivityAt         DateTime?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  department             Department?                      @relation(fields: [departmentId], references: [id])
  designation            Designation?                     @relation(fields: [designationId], references: [id])
  manager                AdminUserProfile?                 @relation("AdminStaffReportingLine", fields: [managerId], references: [id], onDelete: SetNull)
  directReports          AdminUserProfile[]                @relation("AdminStaffReportingLine")
  presence                    AdminStaffPresence?
  roles                       UserRole[]
  meetingsCreated             Meeting[]                  @relation("MeetingCreatedBy")
  meetingsHosted              Meeting[]                  @relation("MeetingHostedBy")
  meetingParticipants         MeetingParticipant[]       @relation("MeetingParticipantStaff")
  meetingInvitationsCreated   MeetingInvitation[]        @relation("MeetingInvitationCreatedBy")
  meetingLobbyDecisions       MeetingLobbyEntry[]        @relation("MeetingLobbyDecidedBy")
  meetingsCancelled           Meeting[]                   @relation("MeetingCancelledBy")
  enterpriseFormsCreated      EnterpriseForm[]            @relation("EnterpriseFormCreatedBy")
  enterpriseFormsArchived     EnterpriseForm[]            @relation("EnterpriseFormArchivedBy")
  formVersionsCreated         EnterpriseFormVersion[]     @relation("EnterpriseFormVersionCreatedBy")
  formVersionsPublished       EnterpriseFormVersion[]     @relation("EnterpriseFormVersionPublishedBy")
  formVersionsRetired         EnterpriseFormVersion[]     @relation("EnterpriseFormVersionRetiredBy")

  @@index([departmentId])
  @@index([designationId])
  @@index([managerId])
  @@index([lifecycleState])
  @@index([lastActivityAt])
}

model AdminStaffPresence {
  id              String                  @id @default(cuid())
  staffProfileId  String                  @unique
  state           AdminStaffPresenceState @default(OFFLINE)
  note            String?                 @db.VarChar(240)
  lastHeartbeatAt DateTime                @default(now())
  expiresAt       DateTime
  updatedByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  staffProfile    AdminUserProfile        @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([state, expiresAt])
  @@index([expiresAt])
}

model Meeting {
  id                   String                @id @default(cuid())
  roomId               String                @unique @db.VarChar(180)
  kind                 MeetingKind           @default(STANDARD)
  state                MeetingState          @default(DRAFT)
  title                String                @db.VarChar(240)
  agenda               String?
  timezone             String                @default("Africa/Johannesburg") @db.VarChar(120)
  startsAt             DateTime
  endsAt               DateTime
  durationMinutes      Int
  createdByProfileId   String
  hostProfileId        String
  contextType          String?               @db.VarChar(80)
  contextId            String?               @db.VarChar(240)
  allowAudio           Boolean               @default(true)
  allowVideo           Boolean               @default(true)
  allowChat            Boolean               @default(true)
  allowFiles           Boolean               @default(true)
  allowScreenShare     Boolean               @default(true)
  allowRecording       Boolean               @default(false)
  lobbyRequired        Boolean               @default(true)
  lockedAt             DateTime?
  startedAt            DateTime?
  endedAt              DateTime?
  cancelledAt          DateTime?
  cancelledByProfileId String?
  cancellationReason   String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdByProfile     AdminUserProfile      @relation("MeetingCreatedBy", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  hostProfile          AdminUserProfile      @relation("MeetingHostedBy", fields: [hostProfileId], references: [id], onDelete: Restrict)
  cancelledByProfile   AdminUserProfile?     @relation("MeetingCancelledBy", fields: [cancelledByProfileId], references: [id], onDelete: SetNull)
  participants         MeetingParticipant[]
  invitations          MeetingInvitation[]
  lobbyEntries         MeetingLobbyEntry[]
  attendanceSessions   MeetingAttendanceSession[]

  @@index([state, startsAt])
  @@index([createdByProfileId, createdAt])
  @@index([hostProfileId, startsAt])
  @@index([contextType, contextId])
}

model MeetingParticipant {
  id                 String                  @id @default(cuid())
  meetingId          String
  participantType    MeetingParticipantType
  staffProfileId     String?
  emailNormalized    String?                 @db.VarChar(320)
  displayName        String                  @db.VarChar(240)
  role               MeetingParticipantRole  @default(ATTENDEE)
  state              MeetingParticipantState @default(INVITED)
  invitedAt          DateTime                @default(now())
  acceptedAt         DateTime?
  declinedAt         DateTime?
  firstJoinedAt      DateTime?
  lastLeftAt         DateTime?
  removedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  meeting            Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  staffProfile       AdminUserProfile?       @relation("MeetingParticipantStaff", fields: [staffProfileId], references: [id], onDelete: SetNull)
  invitations        MeetingInvitation[]
  lobbyEntries       MeetingLobbyEntry[]
  attendanceSessions MeetingAttendanceSession[]

  @@unique([meetingId, staffProfileId], map: "meeting_participant_staff_key")
  @@unique([meetingId, emailNormalized], map: "meeting_participant_email_key")
  @@index([meetingId, role, state])
  @@index([emailNormalized, meetingId])
  @@index([staffProfileId, state])
}

model MeetingInvitation {
  id                 String                 @id @default(cuid())
  meetingId          String
  participantId      String
  emailNormalized    String                 @db.VarChar(320)
  tokenHash          String                 @unique @db.VarChar(128)
  pinHash            String?                @db.VarChar(320)
  state              MeetingInvitationState @default(PENDING)
  expiresAt          DateTime
  verifiedAt         DateTime?
  revokedAt          DateTime?
  lastUsedAt         DateTime?
  attemptCount       Int                    @default(0)
  lockedUntil        DateTime?
  createdByProfileId String
  subjectOverride    String?                @db.VarChar(240)
  messageOverride    String?
  templateKey        String?                @db.VarChar(120)
  templateVersion    String?                @db.VarChar(80)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  meeting            Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant        MeetingParticipant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdByProfile   AdminUserProfile       @relation("MeetingInvitationCreatedBy", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  guestSessions      MeetingGuestSession[]

  @@index([meetingId, state, expiresAt])
  @@index([emailNormalized, createdAt])
  @@index([participantId, createdAt])
}

model MeetingGuestSession {
  id               String            @id @default(cuid())
  invitationId     String
  sessionTokenHash String            @unique @db.VarChar(128)
  expiresAt        DateTime
  verifiedAt       DateTime          @default(now())
  revokedAt        DateTime?
  ipHash           String?           @db.VarChar(128)
  userAgent        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  invitation       MeetingInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  lobbyEntries     MeetingLobbyEntry[]

  @@index([invitationId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model MeetingLobbyEntry {
  id                 String            @id @default(cuid())
  meetingId          String
  participantId      String
  guestSessionId     String?
  state              MeetingLobbyState @default(WAITING)
  requestedAt        DateTime          @default(now())
  decidedAt          DateTime?
  decidedByProfileId String?
  decisionReason     String?           @db.VarChar(500)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  meeting            Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant        MeetingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  guestSession       MeetingGuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  decidedByProfile   AdminUserProfile? @relation("MeetingLobbyDecidedBy", fields: [decidedByProfileId], references: [id], onDelete: SetNull)

  @@unique([meetingId, participantId], map: "meeting_lobby_participant_key")
  @@index([meetingId, state, requestedAt])
  @@index([guestSessionId])
}

model MeetingAttendanceSession {
  id               String             @id @default(cuid())
  meetingId        String
  participantId    String
  clientSessionId  String             @unique @db.VarChar(128)
  joinedAt         DateTime           @default(now())
  lastHeartbeatAt  DateTime           @default(now())
  leftAt           DateTime?
  durationSeconds  Int                @default(0)
  disconnectReason String?            @db.VarChar(240)
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  meeting          Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant      MeetingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([meetingId, joinedAt])
  @@index([participantId, joinedAt])
}

model EnterpriseForm {
  id                 String               @id @default(cuid())
  key                String               @unique @db.VarChar(120)
  slug               String               @unique @db.VarChar(160)
  name               String               @db.VarChar(240)
  description        String?
  status             EnterpriseFormStatus @default(ACTIVE)
  defaultLocale      String               @default("en") @db.VarChar(20)
  createdByProfileId String
  archivedAt         DateTime?
  archivedByProfileId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdByProfile   AdminUserProfile     @relation("EnterpriseFormCreatedBy", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  archivedByProfile  AdminUserProfile?    @relation("EnterpriseFormArchivedBy", fields: [archivedByProfileId], references: [id], onDelete: SetNull)
  versions           EnterpriseFormVersion[]
  submissions        EnterpriseFormSubmission[]

  @@index([status, createdAt])
  @@index([createdByProfileId, createdAt])
}

model EnterpriseFormVersion {
  id                   String                     @id @default(cuid())
  formId               String
  versionNumber        Int
  state                EnterpriseFormVersionState @default(DRAFT)
  accessMode           EnterpriseFormAccessMode   @default(PUBLIC)
  title                String                     @db.VarChar(240)
  description          String?
  locale               String                     @default("en") @db.VarChar(20)
  fallbackLocale       String?                    @db.VarChar(20)
  submitLabel          String                     @default("Submit") @db.VarChar(120)
  allowSaveResume      Boolean                    @default(true)
  acceptingFrom        DateTime?
  acceptingUntil       DateTime?
  retentionDays        Int?
  branding             Json?
  settings             Json?
  notificationRules    Json?
  antiSpamPolicy       Json?
  createdFromVersionId String?
  createdByProfileId   String
  publishedAt          DateTime?
  publishedByProfileId String?
  retiredAt            DateTime?
  retiredByProfileId   String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  form                 EnterpriseForm             @relation(fields: [formId], references: [id], onDelete: Restrict)
  createdFromVersion   EnterpriseFormVersion?     @relation("EnterpriseFormVersionClone", fields: [createdFromVersionId], references: [id], onDelete: SetNull)
  clonedVersions       EnterpriseFormVersion[]    @relation("EnterpriseFormVersionClone")
  createdByProfile     AdminUserProfile           @relation("EnterpriseFormVersionCreatedBy", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  publishedByProfile   AdminUserProfile?          @relation("EnterpriseFormVersionPublishedBy", fields: [publishedByProfileId], references: [id], onDelete: SetNull)
  retiredByProfile     AdminUserProfile?          @relation("EnterpriseFormVersionRetiredBy", fields: [retiredByProfileId], references: [id], onDelete: SetNull)
  pages                EnterpriseFormPage[]
  sections             EnterpriseFormSection[]
  fields               EnterpriseFormField[]
  options              EnterpriseFormFieldOption[]
  rules                EnterpriseFormRule[]
  translations         EnterpriseFormTranslation[]
  submissions          EnterpriseFormSubmission[]

  @@unique([formId, versionNumber])
  @@index([formId, state, versionNumber])
  @@index([state, acceptingFrom, acceptingUntil])
  @@index([createdFromVersionId])
}

model EnterpriseFormPage {
  id          String                @id @default(cuid())
  versionId   String
  key         String                @db.VarChar(120)
  title       String                @db.VarChar(240)
  description String?
  order       Int
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  version     EnterpriseFormVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sections    EnterpriseFormSection[]

  @@unique([versionId, key])
  @@unique([versionId, order])
  @@index([versionId, order])
}

model EnterpriseFormSection {
  id          String                @id @default(cuid())
  versionId   String
  pageId      String
  key         String                @db.VarChar(120)
  title       String                @db.VarChar(240)
  description String?
  order       Int
  repeatable  Boolean               @default(false)
  minRepeats  Int?
  maxRepeats  Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  version     EnterpriseFormVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  page        EnterpriseFormPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fields      EnterpriseFormField[]

  @@unique([versionId, key])
  @@unique([pageId, order])
  @@index([versionId, order])
  @@index([pageId, order])
}

model EnterpriseFormField {
  id              String                  @id @default(cuid())
  versionId       String
  sectionId       String
  key             String                  @db.VarChar(120)
  type            EnterpriseFormFieldType
  label           String                  @db.VarChar(240)
  helpText        String?
  placeholder     String?                 @db.VarChar(500)
  order           Int
  required        Boolean                 @default(false)
  sensitive       Boolean                 @default(false)
  defaultValue    Json?
  validation      Json?
  visibilityLogic Json?
  calculation     Json?
  scoring         Json?
  config          Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  version         EnterpriseFormVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  section         EnterpriseFormSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options         EnterpriseFormFieldOption[]
  answers         EnterpriseFormSubmissionAnswer[]
  files           EnterpriseFormSubmissionFile[]
  consents        EnterpriseFormConsentEvidence[]

  @@unique([versionId, key])
  @@unique([sectionId, order])
  @@index([versionId, type])
  @@index([sectionId, order])
}

model EnterpriseFormFieldOption {
  id        String                @id @default(cuid())
  versionId String
  fieldId   String
  key       String                @db.VarChar(120)
  label     String                @db.VarChar(240)
  value     String                @db.VarChar(240)
  order     Int
  metadata  Json?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  version   EnterpriseFormVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  field     EnterpriseFormField   @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, key])
  @@unique([fieldId, value])
  @@unique([fieldId, order])
  @@index([versionId, fieldId])
}

model EnterpriseFormRule {
  id        String                 @id @default(cuid())
  versionId String
  key       String                 @db.VarChar(120)
  kind      EnterpriseFormRuleKind
  priority  Int                    @default(0)
  condition Json
  effect    Json
  enabled   Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  version   EnterpriseFormVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@index([versionId, kind, priority])
}

model EnterpriseFormTranslation {
  id         String                          @id @default(cuid())
  versionId  String
  locale     String                          @db.VarChar(20)
  targetType EnterpriseFormTranslationTarget
  targetKey  String                          @db.VarChar(120)
  values     Json
  createdAt  DateTime                        @default(now())
  updatedAt  DateTime                        @updatedAt
  version    EnterpriseFormVersion           @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, locale, targetType, targetKey])
  @@index([versionId, locale])
}

model EnterpriseFormSubmission {
  id                      String                         @id @default(cuid())
  formId                  String
  versionId               String
  status                  EnterpriseFormSubmissionStatus @default(DRAFT)
  resumeTokenHash         String?                        @unique @db.VarChar(128)
  resumeTokenExpiresAt    DateTime?
  identityEmailNormalized String?                        @db.VarChar(320)
  contextType             String?                        @db.VarChar(80)
  contextId               String?                        @db.VarChar(240)
  locale                  String                         @default("en") @db.VarChar(20)
  source                  String?                        @db.VarChar(80)
  metadata                Json?
  startedAt               DateTime                       @default(now())
  lastSavedAt             DateTime                       @default(now())
  submittedAt             DateTime?
  expiresAt               DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  form                    EnterpriseForm                 @relation(fields: [formId], references: [id], onDelete: Restrict)
  version                 EnterpriseFormVersion          @relation(fields: [versionId], references: [id], onDelete: Restrict)
  answers                 EnterpriseFormSubmissionAnswer[]
  files                   EnterpriseFormSubmissionFile[]
  consents                EnterpriseFormConsentEvidence[]

  @@index([formId, status, createdAt])
  @@index([versionId, status, createdAt])
  @@index([identityEmailNormalized, createdAt])
  @@index([contextType, contextId])
  @@index([expiresAt, status])
}

model EnterpriseFormSubmissionAnswer {
  id           String                   @id @default(cuid())
  submissionId String
  fieldId      String
  fieldKey     String                   @db.VarChar(120)
  value        Json
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  submission   EnterpriseFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field        EnterpriseFormField      @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([submissionId, fieldId])
  @@index([fieldId])
}

model EnterpriseFormSubmissionFile {
  id             String                    @id @default(cuid())
  submissionId   String
  fieldId        String
  fieldKey       String                    @db.VarChar(120)
  objectKey      String                    @unique @db.VarChar(512)
  fileName       String                    @db.VarChar(255)
  contentType    String                    @db.VarChar(160)
  sizeBytes      Int
  checksumSha256 String?                   @db.VarChar(64)
  state          EnterpriseFormFileState   @default(PENDING)
