  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientMemberId, periodKey, source])
  @@index([orgId, clientId, periodKey])
  @@index([clientMemberId, periodKey])
  @@index([patientId])
  @@index([status])
  @@index([eligibilityStatus])
  @@index([premiumStatus])
