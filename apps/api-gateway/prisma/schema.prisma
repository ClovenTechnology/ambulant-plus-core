generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum AllergySeverity {
  Mild
  Moderate
  Severe
}

enum AllergyStatus {
  Active
  Resolved
}

enum AllergyReactionSeverity {
  mild
  moderate
  severe
}

enum PatientDocumentStatus {
  PENDING_UPLOAD
  READY
  SCANNING
  CLEAN
  INFECTED
  FAILED
  DELETED
}

enum ClaimsSubmissionMode {
  AUTO
  API
  MANUAL_REVIEW
  HYBRID
}

enum EligibilityMode {
  UPLOAD
  API
  HYBRID
  MANUAL
}

enum ClientMemberSource {
  PATIENT_SELF_LINK
  CLIENT_UPLOAD
  API_SYNC
}

enum ClientMemberVerification {
  PENDING
  VERIFIED
  FAILED
  MANUAL_REVIEW
}

enum ClientConsentScope {
  CLAIMS
  VITALS
  REPORTS
  CARE_COORDINATION
}

enum FundingSourceType {
  CARD
  MEDICAL_AID
  HMO
  CORPORATE_SPONSOR
  VOUCHER
  MIXED
}

enum ClientClaimEvidenceKind {
  ENCOUNTER_SUMMARY
  ICD10
  PRESCRIPTION
  LAB_ORDER
  CONSENT
  VITALS_SUMMARY
  REPORT
  PREAUTH
}

enum ClientClaimEvidenceVisibility {
  CLAIMS_ONLY
  CLAIMS_AND_COORDINATION
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model OrganizationSettings {
  orgId               String   @id
  defaultCountry      String   @default("ZA") @db.VarChar(2)
  defaultLocale       String   @default("en-ZA") @db.VarChar(12)
  defaultCurrency     String   @default("ZAR") @db.VarChar(3)
  supportedLocales    String[] @default(["en-ZA", "fr-FR", "pt-PT", "af-ZA"])
  supportedCurrencies String[] @default(["ZAR", "USD", "EUR"])
  weekStartsOn        String   @default("monday")
  timezone            String   @default("Africa/Johannesburg")
  updatedAt           DateTime @updatedAt
  updatedByUserId     String?
}

model UserLocalePreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  country   String?  @db.VarChar(2)
  locale    String?  @db.VarChar(12)
  currency  String?  @db.VarChar(3)
  timezone  String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orgId     String   @default("org-default")

  @@index([orgId])
}

model ClinicianFee {
  id              String           @id @default(cuid())
  clinicianUserId String
  kind            ClinicianFeeKind
  currency        String           @db.VarChar(3)
  amountMinor     Int
  active          Boolean          @default(true)
  effectiveFrom   DateTime         @default(now())
  effectiveTo     DateTime?
  orgId           String           @default("org-default")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  visitMode       VisitMode        @default(televisit)
  clinician       ClinicianProfile @relation(fields: [clinicianUserId], references: [userId], onDelete: Cascade)

  @@index([clinicianUserId, kind, visitMode, currency, active])
  @@index([orgId])
}

model DeviceCatalog {
  slug        String       @id
  label       String
  vendor      String
  modality    String
  transport   String
  services    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userDevices UserDevice[]
}

model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  catalogSlug String
  nickname    String?
  transport   String
  pairedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  identifiers Json?
  meta        Json?

  ownershipType         String?
  fundingSourceType     String?
  fundingSourceId       String?
  sponsoredProgramId    String?
  sponsoredAssignmentId String?

  catalog DeviceCatalog @relation(fields: [catalogSlug], references: [slug])

  @@index([userId])
  @@index([catalogSlug])
  @@index([fundingSourceType, fundingSourceId])
  @@index([sponsoredProgramId])
  @@index([sponsoredAssignmentId])
}

model Encounter {
  id          String  @id
  caseId      String
  patientId   String
  clinicianId String?

  sessionId             String?
  consultationStartedAt DateTime?
  consultationEndedAt   DateTime?
  visitMode             AppointmentVisitMode?
  settlementSnapshot    Json?
  summaryPayload        Json?

  clientId        String?
  clientMemberId  String?
  coveragePlanId  String?
  sponsorSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String

  orgId String @default("org-default")

  appointments             Appointment[]
  erxOrders                ErxOrder[]
  labOrders                LabOrder[]
  payments                 Payment[]
  documents                PatientDocument[]
  consultationInviteQuotes  ConsultationSessionInviteQuote[]
  collaborativeDrafts       CollaborativeAppointmentDraft[]  @relation("DraftsFromEncounter")
  appointmentCareRecipients AppointmentCareRecipient[]       @relation("AppointmentCareRecipientEncounter")

  diagnoses         EncounterDiagnosis[]
  labResults        LabResult[]
  clinicalFindings  ClinicalFinding[]
  clinicalEvidence  ClinicalEvidence[]
  clinicalArtifacts ClinicalArtifact[]

  surgicalCases  SurgicalCase[]
  surgicalEvents SurgicalProcedureEvent[]

  @@index([orgId])
  @@index([sessionId])
  @@index([status])
  @@index([clientId])
  @@index([clientMemberId])
}

model ConsultationSession {
  id                    String                           @id @default(cuid())
  appointmentId         String                           @unique
  encounterId           String?
  caseId                String
  clinicianId           String
  patientId             String
  hostUserId            String?
  visitMode             AppointmentVisitMode
  roomId                String?
  state                 ConsultationSessionState         @default(CREATED)
  patientCheckedInAt    DateTime?
  clinicianCheckedInAt  DateTime?
  startedAt             DateTime?
  endedAt               DateTime?
  cancelledAt           DateTime?
  cancelledBy           ConsultationActorType?
  cancelReason          String?
  noShowMarkedAt        DateTime?
  noShowActor           ConsultationActorType?
  outcome               ConsultationOutcomeKind?
  refundType            SettlementRefundType             @default(NONE)
  refundTarget          SettlementRefundTarget           @default(NONE)
  payoutState           SettlementPayoutState            @default(HOLD)
  claimState            SettlementClaimState             @default(NOT_ELIGIBLE)
  reasonCode            String?
  policyVersion         String                           @default("session-policy-v1")
  currency              String                           @default("USD")
  amountAuthorizedMinor Int?
  amountCapturedMinor   Int?
  amountRefundedMinor   Int                              @default(0)
  metadata              Json?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  collaborativeDrafts   CollaborativeAppointmentDraft[]  @relation("DraftsFromSession")
  inviteQuotes          ConsultationSessionInviteQuote[]

  @@index([patientId, createdAt])
  @@index([clinicianId, createdAt])
  @@index([caseId])
  @@index([encounterId])
  @@index([state])
  @@index([visitMode])
}

model ConsultationSessionInviteQuote {
  id                     String                               @id @default(cuid())
  consultationSessionId  String
  appointmentId          String
  encounterId            String?
  caseId                 String
  patientId              String
  leadClinicianId        String
  requestedByClinicianId String
  intent                 ConsultationInviteIntent             @default(LIVE_JOIN_NOW)
  status                 ConsultationInviteQuoteStatus        @default(REQUESTED)
  currency               String                               @db.VarChar(3)
  subtotalMinor          Int
  coveredMinor           Int                                  @default(0)
  copayMinor             Int                                  @default(0)
  totalMinor             Int
  sponsorDecisionJson    Json?
  payloadJson            Json?
  metadata               Json?
  requestedAt            DateTime                             @default(now())
  approvedAt             DateTime?
  declinedAt             DateTime?
  expiresAt              DateTime?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  orgId                  String                               @default("org-default")
  appointment            Appointment                          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  consultationSession    ConsultationSession                  @relation(fields: [consultationSessionId], references: [id], onDelete: Cascade)
  encounter              Encounter?                           @relation(fields: [encounterId], references: [id])
  lines                  ConsultationSessionInviteQuoteLine[]

  @@index([consultationSessionId, createdAt])
  @@index([appointmentId, createdAt])
  @@index([encounterId, createdAt])
  @@index([patientId, createdAt])
  @@index([leadClinicianId, createdAt])
  @@index([requestedByClinicianId, createdAt])
  @@index([status, createdAt])
  @@index([orgId, status, createdAt])
}

model ConsultationSessionInviteQuoteLine {
  id          String                         @id @default(cuid())
  quoteId     String
  clinicianId String
  role        ConsultationInviteLineRole
  feeKind     ClinicianFeeKind
  visitMode   AppointmentVisitMode
  specialty   String?
  required    Boolean                        @default(true)
  amountMinor Int
  currency    String                         @db.VarChar(3)
  metadata    Json?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  orgId       String                         @default("org-default")
  quote       ConsultationSessionInviteQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([clinicianId, createdAt])
  @@index([role, createdAt])
  @@index([orgId, quoteId])
}

model CollaborativeAppointmentDraft {
  id                          String                              @id @default(cuid())
  sourceConsultationSessionId String?
  sourceEncounterId           String?
  appointmentId               String?
  caseId                      String
  patientId                   String
  leadClinicianId             String
  requestedByClinicianId      String
  status                      CollaborativeAppointmentDraftStatus @default(DRAFT)
  visitMode                   AppointmentVisitMode
  startsAt                    DateTime?
  endsAt                      DateTime?
  durationMin                 Int?
  currency                    String                              @db.VarChar(3)
  subtotalMinor               Int                                 @default(0)
  coveredMinor                Int                                 @default(0)
  copayMinor                  Int                                 @default(0)
  totalMinor                  Int                                 @default(0)
  sponsorDecisionJson         Json?
  payloadJson                 Json?
  metadata                    Json?
  approvedAt                  DateTime?
  declinedAt                  DateTime?
  bookedAt                    DateTime?
  expiresAt                   DateTime?
  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @updatedAt
  orgId                       String                              @default("org-default")
  appointment                 Appointment?                        @relation("DraftsFromAppointment", fields: [appointmentId], references: [id])
  sourceConsultationSession   ConsultationSession?                @relation("DraftsFromSession", fields: [sourceConsultationSessionId], references: [id])
  sourceEncounter             Encounter?                          @relation("DraftsFromEncounter", fields: [sourceEncounterId], references: [id])
  lines                       CollaborativeAppointmentDraftLine[]

  @@index([sourceConsultationSessionId, createdAt])
  @@index([sourceEncounterId, createdAt])
  @@index([appointmentId, createdAt])
  @@index([patientId, createdAt])
  @@index([leadClinicianId, createdAt])
  @@index([requestedByClinicianId, createdAt])
  @@index([status, createdAt])
  @@index([orgId, status, createdAt])
}

model CollaborativeAppointmentDraftLine {
  id          String                        @id @default(cuid())
  draftId     String
  clinicianId String
  role        ConsultationInviteLineRole
  feeKind     ClinicianFeeKind
  visitMode   AppointmentVisitMode
  specialty   String?
  required    Boolean                       @default(true)
  amountMinor Int
  currency    String                        @db.VarChar(3)
  metadata    Json?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  orgId       String                        @default("org-default")
  draft       CollaborativeAppointmentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([clinicianId, createdAt])
  @@index([role, createdAt])
  @@index([orgId, draftId])
}

model Appointment {
  id          String  @id
  encounterId String
  sessionId   String?
  caseId      String

  clinicianId String
  patientId   String

  hostUserId           String?
  subjectPatientId     String?
  familyRelationshipId String?
  parentAppointmentId  String?

  roomId    String?
  reason    String?
  kind      AppointmentKind      @default(STANDARD)
  visitMode AppointmentVisitMode @default(TELEVISIT)

  startsAt DateTime
  endsAt   DateTime
  status   String

  paymentMethod   AppointmentPaymentMethod?
  paymentStatus   AppointmentPaymentStatus  @default(PENDING)
  paymentIntentId String?
  paymentProvider String?
  paymentRef      String?

  priceCents         Int
  currency           String @default("USD")
  platformFeeCents   Int
  clinicianTakeCents Int

  amountMinor   Int?
  subtotalMinor Int?
  taxMinor      Int?
  discountMinor Int?
  totalMinor    Int?

  clientId                String?
  clientMemberId          String?
  coveragePlanId          String?
  coverageAuthorizationId String?

  coverageDecision       String?
  sponsorAmountMinor     Int?
  patientCopayMinor      Int?
  sponsorCurrency        String? @db.VarChar(3)
  sponsorPricingSnapshot Json?

  bookingSource     String?
  rescheduleCount   Int       @default(0)
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?

  confirmedAt DateTime?
  checkedInAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  meta      Json?
  orgId     String   @default("org-default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounter                Encounter                         @relation(fields: [encounterId], references: [id])
  bookingIntent            BookingIntent?
  consultationInviteQuotes ConsultationSessionInviteQuote[]
  collaborativeDrafts      CollaborativeAppointmentDraft[]   @relation("DraftsFromAppointment")
  participants             AppointmentParticipant[]
  careRecipients           AppointmentCareRecipient[]
  participantInvitations   AppointmentParticipantInvitation[]

  @@index([clinicianId, startsAt])
  @@index([patientId, startsAt])
  @@index([subjectPatientId, startsAt])
  @@index([status, startsAt])
  @@index([roomId, startsAt])
  @@index([orgId, clinicianId, startsAt])
  @@index([orgId, patientId, startsAt])
  @@index([orgId, subjectPatientId, startsAt])
  @@index([clientId, startsAt])
  @@index([clientMemberId, startsAt])
  @@index([coverageAuthorizationId])
}


model ClinicianMultiCarePolicy {
  id                                         String               @id @default(cuid())
  clinicianUserId                            String
  feeKind                                    ClinicianFeeKind
  visitMode                                  VisitMode             @default(televisit)
  enabled                                    Boolean               @default(false)
  pricingMode                                MultiCarePricingMode   @default(BASE_PLUS_ADDITIONAL)
  currency                                   String                @db.VarChar(3)
  includedCareRecipients                     Int                   @default(1)
  additionalRecipientAmountMinor             Int?
  additionalRecipientPercentBps              Int?
  packageAmountMinor                         Int?
  maxCareRecipients                          Int                   @default(2)
  additionalMinutesPerRecipient              Int                   @default(0)
  maxAdditionalMinutes                       Int?
  requireAllRecipientsVerifiedBeforeCheckout Boolean               @default(true)
  allowPendingAdultInvitations                Boolean               @default(false)
  allowProvisionalDependentProfiles           Boolean               @default(true)
  effectiveFrom                              DateTime              @default(now())
  effectiveTo                                DateTime?
  version                                    Int                   @default(1)
  metadata                                   Json?
  orgId                                      String                @default("org-default")
  createdAt                                  DateTime              @default(now())
  updatedAt                                  DateTime              @updatedAt

  clinician     ClinicianProfile          @relation(fields: [clinicianUserId], references: [userId], onDelete: Cascade)
  careRecipients AppointmentCareRecipient[]

  @@unique([clinicianUserId, feeKind, visitMode, version])
  @@index([clinicianUserId, feeKind, visitMode, enabled, effectiveFrom])
  @@index([orgId, clinicianUserId])
}

model BookingIntent {
  id                 String              @id
  requestFingerprint String              @db.VarChar(64)
  idempotencyKeyHash String              @db.VarChar(64)
  hostUserId         String
  actorPatientId     String
  clinicianId        String
  status             BookingIntentStatus @default(DRAFT)
  fundingMethod      AppointmentPaymentMethod?
  kind               AppointmentKind      @default(STANDARD)
  visitMode          AppointmentVisitMode @default(TELEVISIT)

  startsAt DateTime
  endsAt   DateTime
  slotKey  String   @db.VarChar(191)

  slotOfferHash      String?   @db.VarChar(64)
  slotOfferExpiresAt DateTime?
  priceLockHash      String?   @db.VarChar(64)
  priceLockExpiresAt DateTime?
  holdExpiresAt      DateTime?

  amountMinor          Int @default(0)
  subtotalMinor        Int @default(0)
  taxMinor             Int @default(0)
  discountMinor        Int @default(0)
  totalMinor           Int @default(0)
  sponsorAmountMinor   Int @default(0)
  patientPayableMinor  Int @default(0)
  currency             String @db.VarChar(3)
  coverageDecision     String?
  coverageAuthorizationId String?

  reason        String?
  caseId        String?
  appointmentId String? @unique
  authorizedAt  DateTime?
  confirmedAt   DateTime?
  expiredAt     DateTime?
  cancelledAt   DateTime?
  failureCode   String?
  version       Int      @default(1)

  quoteSnapshot     Json?
  coverageSnapshot  Json?
  recipientSnapshot Json?
  metadata          Json?

  orgId     String   @default("org-default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment     Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  slotLease       BookingSlotLease?
  recipients      BookingIntentRecipient[]
  paymentAttempts BookingPaymentAttempt[]
  auditEvents     BookingIntentAuditEvent[]

  @@unique([hostUserId, idempotencyKeyHash])
  @@index([clinicianId, startsAt, endsAt])
  @@index([hostUserId, status, createdAt])
  @@index([actorPatientId, status, createdAt])
  @@index([status, holdExpiresAt])
  @@index([slotKey, status])
  @@index([orgId, status, createdAt])
}

model BookingIntentRecipient {
  id                   String                       @id @default(cuid())
  bookingIntentId      String
  patientId            String?
  patientUserId        String?
  hostUserId           String
  familyRelationshipId String?
  role                 AppointmentCareRecipientRole
  sequence             Int                          @default(0)
  status               BookingIntentRecipientStatus @default(READY)
  identityVerifiedAt   DateTime?
  reason               String?
  caseId               String?

  baseAmountMinor       Int @default(0)
  additionalAmountMinor Int @default(0)
  discountMinor         Int @default(0)
  grossAmountMinor      Int @default(0)
  sponsorAmountMinor    Int @default(0)
  patientPayableMinor   Int @default(0)
  currency              String @db.VarChar(3)

  coverageDecision        String?
  coverageAuthorizationId String?
  pricingSnapshot         Json?
  coverageSnapshot        Json?
  metadata                Json?

  orgId     String   @default("org-default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingIntent BookingIntent @relation(fields: [bookingIntentId], references: [id], onDelete: Cascade)

  @@unique([bookingIntentId, patientId])
  @@unique([bookingIntentId, sequence])
  @@index([patientId])
  @@index([patientUserId])
  @@index([hostUserId])
  @@index([familyRelationshipId])
  @@index([coverageAuthorizationId])
  @@index([orgId, bookingIntentId])
}

model BookingSlotLease {
  id              String                 @id @default(cuid())
  bookingIntentId String                 @unique
  slotKey         String                 @db.VarChar(191)
  clinicianId     String
  startsAt        DateTime
  endsAt          DateTime
  status          BookingSlotLeaseStatus @default(ACTIVE)
  holdTokenHash   String                 @db.VarChar(64)
  expiresAt       DateTime
  acquiredAt      DateTime               @default(now())
  consumedAt      DateTime?
  releasedAt      DateTime?
  releaseReason   String?
  version         Int                    @default(1)
  metadata        Json?
  orgId           String                 @default("org-default")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  bookingIntent BookingIntent @relation(fields: [bookingIntentId], references: [id], onDelete: Cascade)

  @@index([slotKey, status, expiresAt])
  @@index([clinicianId, startsAt, endsAt])
  @@index([status, expiresAt])
  @@index([orgId, status, expiresAt])
}

model BookingPaymentAttempt {
  id                 String                      @id
  bookingIntentId    String
  sequence           Int                         @default(1)
  method             AppointmentPaymentMethod
  status             BookingPaymentAttemptStatus @default(CREATED)
  provider           String?
  providerRef        String?                     @unique @db.VarChar(160)
  idempotencyKeyHash String                       @db.VarChar(64)
  amountMinor        Int
  currency           String                      @db.VarChar(3)
  expiresAt          DateTime?
  authorizedAt       DateTime?
  capturedAt         DateTime?
  failedAt           DateTime?
  cancelledAt        DateTime?
  failureCode        String?
  providerSnapshot   Json?
  verificationSnapshot Json?
  metadata           Json?
  orgId              String                      @default("org-default")
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  bookingIntent BookingIntent @relation(fields: [bookingIntentId], references: [id], onDelete: Cascade)

  @@unique([bookingIntentId, sequence])
  @@unique([bookingIntentId, idempotencyKeyHash])
  @@index([bookingIntentId, status, createdAt])
  @@index([status, expiresAt])
  @@index([orgId, status, createdAt])
}

model BookingIntentAuditEvent {
  id              String               @id @default(cuid())
  bookingIntentId String
  action          String
  fromStatus      BookingIntentStatus?
  toStatus        BookingIntentStatus?
  actorType       String?
  actorUserId     String?
  reason          String?
  beforeJson      Json?
  afterJson       Json?
  orgId           String               @default("org-default")
  createdAt       DateTime             @default(now())

  bookingIntent BookingIntent @relation(fields: [bookingIntentId], references: [id], onDelete: Cascade)

  @@index([bookingIntentId, createdAt])
  @@index([orgId, createdAt])
}

model AppointmentCareRecipient {
  id                     String                         @id @default(cuid())
  appointmentId          String
  patientId              String?
  encounterId            String?                        @unique
  pricingPolicyId        String?
  role                   AppointmentCareRecipientRole
  sequence               Int                            @default(0)
  hostUserId             String?
  familyRelationshipId   String?
  required               Boolean                        @default(true)
  status                 AppointmentCareRecipientStatus @default(READY)
  identityVerifiedAt     DateTime?
  identityVerifiedByUserId String?
  reason                 String?
  baseAmountMinor        Int                            @default(0)
  additionalAmountMinor  Int                            @default(0)
  discountMinor          Int                            @default(0)
  grossAmountMinor       Int                            @default(0)
  sponsorAmountMinor     Int                            @default(0)
  patientPayableMinor    Int                            @default(0)
  currency               String                         @db.VarChar(3)
  coverageDecision       String?
  coverageAuthorizationId String?
  pricingSnapshot        Json?
  coverageSnapshot       Json?
  metadata               Json?
  orgId                  String                         @default("org-default")
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  appointment       Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient           PatientProfile?            @relation("AppointmentCareRecipientPatient", fields: [patientId], references: [id], onDelete: SetNull)
  encounter         Encounter?                 @relation("AppointmentCareRecipientEncounter", fields: [encounterId], references: [id], onDelete: SetNull)
  pricingPolicy     ClinicianMultiCarePolicy?  @relation(fields: [pricingPolicyId], references: [id], onDelete: SetNull)
  familyRelationship FamilyRelationship?       @relation("AppointmentCareRecipientFamilyRelationship", fields: [familyRelationshipId], references: [id], onDelete: SetNull)
  participants      AppointmentParticipant[]
  invitations       AppointmentParticipantInvitation[]

  @@unique([appointmentId, patientId])
  @@unique([appointmentId, sequence])
  @@index([appointmentId, role, status])
  @@index([patientId])
  @@index([hostUserId])
  @@index([familyRelationshipId])
  @@index([pricingPolicyId])
  @@index([coverageAuthorizationId])
  @@index([orgId, appointmentId])
}

model AppointmentParticipant {
  id                  String                       @id @default(cuid())
  appointmentId       String
  careRecipientId     String?
  partyId             String
  role                AppointmentParticipantRole
  patientId           String?
  clinicianId         String?
  userId              String?
  hostUserId          String?
  familyRelationshipId String?
  displayName         String?
  email               String?
  phone               String?
  required            Boolean                      @default(false)
  status              AppointmentParticipantStatus @default(ACCEPTED)
  consentRequired     Boolean                      @default(true)
  canJoinTelevisit    Boolean                      @default(true)
  canViewHealth       Boolean                      @default(false)
  canBookAppointments Boolean                      @default(false)
  acceptedAt          DateTime?
  declinedAt          DateTime?
  revokedAt           DateTime?
  metadata            Json?
  orgId               String                       @default("org-default")
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  appointment       Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
