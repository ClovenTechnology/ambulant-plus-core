  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions ClientWalletTransaction[]

  @@index([orgId, status])
}

model ClientWalletTransaction {
  id String @id @default(cuid())

  walletId String
  wallet   ClientWalletAccount @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type ClientWalletTransactionType

  amountMinor Int
  currency    String @default("ZAR") @db.VarChar(3)

  refType String?
  refId   String?

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([type, createdAt])
  @@index([refType, refId])
}

model ClientConsentPolicy {
  id    String @id @default(cuid())
  orgId String @default("org-default")

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  scope                 ConsentScopeKind
  enabledByDefault      Boolean          @default(false)
  requiresExplicitGrant Boolean          @default(true)

  policyText    String?
  policyVersion String
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, scope, policyVersion])
  @@index([orgId, clientId, scope])
}

model ClientConsentGrant {
  id    String @id @default(cuid())
  orgId String @default("org-default")

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId    String?
  patientId String?

  scope  ConsentScopeKind
  status ConsentGrantStatus @default(ACTIVE)

  purpose         String?
  grantedVia      String?
  grantedByUserId String?

  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  metadata Json?

  @@index([orgId, clientId, scope, status])
  @@index([patientId, scope, status])
  @@index([userId, scope, status])
}

model SponsoredDeviceProgram {
  id    String @id @default(cuid())
  orgId String @default("org-default")

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name   String
  status SponsoredDeviceProgramStatus @default(DRAFT)

  ownershipType SponsoredDeviceOwnershipType

  allowsTakeHome       Boolean @default(true)
  requiresReturnOnExit Boolean @default(false)
  allowsReassignment   Boolean @default(false)

  allowedCatalogSlugs String[] @default([])
  metadata            Json?

  startAt DateTime?
  endAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments SponsoredDeviceAssignment[]

  @@index([orgId, clientId, status])
}

model SponsoredDeviceAssignment {
  id    String @id @default(cuid())
  orgId String @default("org-default")

  sponsoredDeviceProgramId String
  sponsoredDeviceProgram   SponsoredDeviceProgram @relation(fields: [sponsoredDeviceProgramId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  clientMemberId String?
  clientMember   ClientMember? @relation(fields: [clientMemberId], references: [id], onDelete: SetNull)

  userId    String?
  patientId String?

  userDeviceId String?

  catalogSlug  String?
  serialNumber String?

  status SponsoredDeviceAssignmentStatus @default(ASSIGNED)

  assignedAt       DateTime  @default(now())
  expectedReturnAt DateTime?
  returnedAt       DateTime?

  assignmentNotes String?
  returnNotes     String?
  metadata        Json?

  @@index([orgId, clientId, status])
  @@index([clientMemberId])
  @@index([userId])
  @@index([patientId])
  @@index([userDeviceId])
}

model ClientMemberConsent {
  id    String @id @default(cuid())
  orgId String @default("org-default")

  clientMemberId String
  clientMember   ClientMember @relation(fields: [clientMemberId], references: [id], onDelete: Cascade)

  patientId String
  scope     ClientConsentScope
  granted   Boolean            @default(false)

  grantedAt DateTime?
  revokedAt DateTime?
  expiresAt DateTime?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, scope, granted])
  @@index([clientMemberId, scope])
}

model ClientClaimEvidence {
  id      String      @id @default(cuid())
  claimId String
  claim   ClientClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  kind       ClientClaimEvidenceKind
  refType    String
  refId      String
  visibility ClientClaimEvidenceVisibility @default(CLAIMS_ONLY)

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([claimId, kind])
}

model ClinicianCommercialProfile {
  id          String           @id @default(cuid())
  clinicianId String           @unique
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)

  commercialMode ClinicianCommercialMode
  canSetOwnFees  Boolean                 @default(true)

  hasOwnPracticeNumber      Boolean             @default(false)
  practiceNumber            String?
  billingProviderType       BillingProviderType
  billingProviderName       String?
  billingProviderPracticeNo String?

  acceptsMedicalAid Boolean @default(false)
  acceptsCash       Boolean @default(true)
  acceptsVoucher    Boolean @default(true)

  feeModel          FeeModelType @default(CLINICIAN_DEFINED)
  specialtyBandKey  String?
  experienceBandKey String?

  contractShareModel       PlatformRecoveryModel @default(PLATFORM_RETENTION)
  directPayRecoveryEnabled Boolean               @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicianId])
}

model FeeScheduleVersion {
  id                  String           @id @default(cuid())
  clinicianId         String
  clinician           ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  commercialProfileId String?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  consultationCents Int
  followupCents     Int
  currency          String @default("ZAR")

  collaborativeFees Json?
  customServices    Json?

  source    FeeScheduleSource @default(CLINICIAN_SAVE)
  createdAt DateTime          @default(now())

  @@index([clinicianId, effectiveFrom])
  @@index([commercialProfileId])
}

model PayoutAllocation {
  id                 String           @id @default(cuid())
  settlementRecordId String
  settlementRecord   SettlementRecord @relation(fields: [settlementRecordId], references: [id], onDelete: Cascade)

  recipientType PayoutRecipientType
  clinicianId   String?
  adminStaffId  String?

  amountMinor  Int
  currency     String                 @default("ZAR")
  scheduledFor DateTime?
  paidAt       DateTime?
  status       PayoutAllocationStatus
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([settlementRecordId, status])
  @@index([clinicianId, status])
  @@index([adminStaffId, status])
}

model RevenueAdjustment {
  id                 String           @id @default(cuid())
  settlementRecordId String
  settlementRecord   SettlementRecord @relation(fields: [settlementRecordId], references: [id], onDelete: Cascade)

  kind        RevenueAdjustmentKind
  amountMinor Int
  currency    String                @default("ZAR")
  reasonCode  String?
  reasonText  String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([settlementRecordId, kind])
}

model PlatformReceivable {
  id                 String           @id @default(cuid())
  clinicianId        String
  clinician          ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  settlementRecordId String?
  amountMinor        Int
  currency           String           @default("ZAR")
  dueDate            DateTime?
  status             ReceivableStatus
  reference          String?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([clinicianId, status])
  @@index([settlementRecordId])
  @@index([dueDate, status])
}

model PatientDataSharingPreference {
  id        String @id @default(cuid())
  patientId String @unique

  allowClinicianAccess                 Boolean @default(true)
  allowMedicalAidAdherenceAccess       Boolean @default(false)
  allowCorporateSponsorAdherenceAccess Boolean @default(false)
  allowRewardProgramAccess             Boolean @default(false)
  allowEvidenceImages                  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

enum ClientOrgType {
  MEDICAL_AID
  HMO
  CORPORATE_SPONSOR
  GYM
  WELLNESS_PARTNER
}

enum ClientWorkspaceType {
  PAYER_OPS
  CORPORATE_SPONSOR
  WELLNESS_PARTNER
}

enum ClientOrgStatus {
  PENDING_REVIEW
  KYB_SUBMITTED
  KYB_UNDER_REVIEW
  KYB_APPROVED
  CONFIGURING
  UAT
  ACTIVE
  RESTRICTED
  SUSPENDED
  ARCHIVED
}

enum ClientOrgUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model ClientOrg {
  id        String          @id @default(cuid())
  name      String
  legalName String?
  orgType   ClientOrgType
  status    ClientOrgStatus @default(PENDING_REVIEW)

  registrationNo    String?
  taxNo             String?
  country           String  @default("ZA")
  region            String?
  currency          String  @default("ZAR")
  timezone          String  @default("Africa/Johannesburg")
  complianceProfile String  @default("ZA_STANDARD")

  metadata Json?

  users       ClientOrgUser[]
  workspaces  ClientOrgWorkspace[]
  invitations ClientOrgInvitation[]
  apiClients  ClientOrgApiClient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientOrgWorkspace {
  id        String              @id @default(cuid())
  orgId     String
  workspace ClientWorkspaceType
  active    Boolean             @default(true)
  metadata  Json?

  org ClientOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, workspace])
}

model ClientOrgUser {
  id     String              @id @default(cuid())
  orgId  String
  userId String
  email  String
  name   String?
  status ClientOrgUserStatus @default(INVITED)

  defaultWorkspace ClientWorkspaceType
  role             String              @default("READ_ONLY_ANALYST")
  scopes           String[]            @default([])

  invitedByUserId String?
  invitedAt       DateTime?
  acceptedAt      DateTime?
  suspendedAt     DateTime?

  org ClientOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, email])
  @@index([userId])
}

model ClientOrgInvitation {
  id     String              @id @default(cuid())
  orgId  String
  email  String
  name   String?
  token  String              @unique
  status ClientOrgUserStatus @default(INVITED)

  role             String
  scopes           String[]            @default([])
  defaultWorkspace ClientWorkspaceType

  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?

  org ClientOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([email])
}

model ClientOrgApiClient {
  id       String   @id @default(cuid())
  orgId    String
  name     String
  clientId String   @unique
  status   String   @default("ACTIVE")
  scopes   String[] @default([])
  metadata Json?

  org ClientOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
