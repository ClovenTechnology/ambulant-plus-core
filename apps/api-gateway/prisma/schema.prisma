generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum AllergySeverity {
  Mild
  Moderate
  Severe
}

enum AllergyStatus {
  Active
  Resolved
}

enum AllergyReactionSeverity {
  mild
  moderate
  severe
}

enum PatientDocumentStatus {
  PENDING_UPLOAD
  READY
  SCANNING
  CLEAN
  INFECTED
  FAILED
  DELETED
}

enum ClaimsSubmissionMode {
  AUTO
  API
  MANUAL_REVIEW
  HYBRID
}

enum EligibilityMode {
  UPLOAD
  API
  HYBRID
  MANUAL
}

enum ClientMemberSource {
  PATIENT_SELF_LINK
  CLIENT_UPLOAD
  API_SYNC
}

enum ClientMemberVerification {
  PENDING
  VERIFIED
  FAILED
  MANUAL_REVIEW
}

enum ClientConsentScope {
  CLAIMS
  VITALS
  REPORTS
  CARE_COORDINATION
}

enum FundingSourceType {
  CARD
  MEDICAL_AID
  HMO
  CORPORATE_SPONSOR
  VOUCHER
  MIXED
}

enum ClientClaimEvidenceKind {
  ENCOUNTER_SUMMARY
  ICD10
  PRESCRIPTION
  LAB_ORDER
  CONSENT
  VITALS_SUMMARY
  REPORT
  PREAUTH
}

enum ClientClaimEvidenceVisibility {
  CLAIMS_ONLY
  CLAIMS_AND_COORDINATION
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model OrganizationSettings {
  orgId               String   @id
  defaultCountry      String   @default("ZA") @db.VarChar(2)
  defaultLocale       String   @default("en-ZA") @db.VarChar(12)
  defaultCurrency     String   @default("ZAR") @db.VarChar(3)
  supportedLocales    String[] @default(["en-ZA", "fr-FR", "pt-PT", "af-ZA"])
  supportedCurrencies String[] @default(["ZAR", "USD", "EUR"])
  weekStartsOn        String   @default("monday")
  timezone            String   @default("Africa/Johannesburg")
  updatedAt           DateTime @updatedAt
  updatedByUserId     String?
}

model UserLocalePreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  country   String?  @db.VarChar(2)
  locale    String?  @db.VarChar(12)
  currency  String?  @db.VarChar(3)
  timezone  String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orgId     String   @default("org-default")

  @@index([orgId])
}

model ClinicianFee {
  id              String           @id @default(cuid())
  clinicianUserId String
  kind            ClinicianFeeKind
  currency        String           @db.VarChar(3)
  amountMinor     Int
  active          Boolean          @default(true)
  effectiveFrom   DateTime         @default(now())
  effectiveTo     DateTime?
  orgId           String           @default("org-default")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  visitMode       VisitMode        @default(televisit)
  clinician       ClinicianProfile @relation(fields: [clinicianUserId], references: [userId], onDelete: Cascade)

  @@index([clinicianUserId, kind, visitMode, currency, active])
  @@index([orgId])
}

model DeviceCatalog {
  slug        String       @id
  label       String
  vendor      String
  modality    String
  transport   String
  services    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userDevices UserDevice[]
}

model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  catalogSlug String
  nickname    String?
  transport   String
  pairedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  identifiers Json?
  meta        Json?

  ownershipType         String?
  fundingSourceType     String?
  fundingSourceId       String?
  sponsoredProgramId    String?
  sponsoredAssignmentId String?

  catalog DeviceCatalog @relation(fields: [catalogSlug], references: [slug])

  @@index([userId])
  @@index([catalogSlug])
  @@index([fundingSourceType, fundingSourceId])
  @@index([sponsoredProgramId])
  @@index([sponsoredAssignmentId])
}

model Encounter {
  id          String  @id
  caseId      String
  patientId   String
  clinicianId String?

  sessionId             String?
  consultationStartedAt DateTime?
  consultationEndedAt   DateTime?
  visitMode             AppointmentVisitMode?
  settlementSnapshot    Json?
  summaryPayload        Json?

  clientId        String?
  clientMemberId  String?
  coveragePlanId  String?
  sponsorSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String

  orgId String @default("org-default")

  appointments             Appointment[]
  erxOrders                ErxOrder[]
  labOrders                LabOrder[]
  payments                 Payment[]
  documents                PatientDocument[]
  consultationInviteQuotes ConsultationSessionInviteQuote[]
  collaborativeDrafts      CollaborativeAppointmentDraft[]  @relation("DraftsFromEncounter")

  diagnoses         EncounterDiagnosis[]
  labResults        LabResult[]
  clinicalFindings  ClinicalFinding[]
  clinicalEvidence  ClinicalEvidence[]
  clinicalArtifacts ClinicalArtifact[]

  surgicalCases  SurgicalCase[]
  surgicalEvents SurgicalProcedureEvent[]

  @@index([orgId])
  @@index([sessionId])
  @@index([status])
  @@index([clientId])
  @@index([clientMemberId])
}

model ConsultationSession {
  id                    String                           @id @default(cuid())
  appointmentId         String                           @unique
  encounterId           String?
  caseId                String
  clinicianId           String
  patientId             String
  hostUserId            String?
  visitMode             AppointmentVisitMode
  roomId                String?
  state                 ConsultationSessionState         @default(CREATED)
  patientCheckedInAt    DateTime?
  clinicianCheckedInAt  DateTime?
  startedAt             DateTime?
  endedAt               DateTime?
  cancelledAt           DateTime?
  cancelledBy           ConsultationActorType?
  cancelReason          String?
  noShowMarkedAt        DateTime?
  noShowActor           ConsultationActorType?
  outcome               ConsultationOutcomeKind?
  refundType            SettlementRefundType             @default(NONE)
  refundTarget          SettlementRefundTarget           @default(NONE)
  payoutState           SettlementPayoutState            @default(HOLD)
  claimState            SettlementClaimState             @default(NOT_ELIGIBLE)
  reasonCode            String?
  policyVersion         String                           @default("session-policy-v1")
  currency              String                           @default("USD")
  amountAuthorizedMinor Int?
  amountCapturedMinor   Int?
  amountRefundedMinor   Int                              @default(0)
  metadata              Json?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  collaborativeDrafts   CollaborativeAppointmentDraft[]  @relation("DraftsFromSession")
  inviteQuotes          ConsultationSessionInviteQuote[]

  @@index([patientId, createdAt])
  @@index([clinicianId, createdAt])
  @@index([caseId])
  @@index([encounterId])
  @@index([state])
  @@index([visitMode])
}

model ConsultationSessionInviteQuote {
  id                     String                               @id @default(cuid())
  consultationSessionId  String
  appointmentId          String
  encounterId            String?
  caseId                 String
  patientId              String
  leadClinicianId        String
  requestedByClinicianId String
  intent                 ConsultationInviteIntent             @default(LIVE_JOIN_NOW)
  status                 ConsultationInviteQuoteStatus        @default(REQUESTED)
  currency               String                               @db.VarChar(3)
  subtotalMinor          Int
  coveredMinor           Int                                  @default(0)
  copayMinor             Int                                  @default(0)
  totalMinor             Int
  sponsorDecisionJson    Json?
  payloadJson            Json?
  metadata               Json?
  requestedAt            DateTime                             @default(now())
  approvedAt             DateTime?
  declinedAt             DateTime?
  expiresAt              DateTime?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  orgId                  String                               @default("org-default")
  appointment            Appointment                          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  consultationSession    ConsultationSession                  @relation(fields: [consultationSessionId], references: [id], onDelete: Cascade)
  encounter              Encounter?                           @relation(fields: [encounterId], references: [id])
  lines                  ConsultationSessionInviteQuoteLine[]

  @@index([consultationSessionId, createdAt])
  @@index([appointmentId, createdAt])
  @@index([encounterId, createdAt])
  @@index([patientId, createdAt])
  @@index([leadClinicianId, createdAt])
  @@index([requestedByClinicianId, createdAt])
  @@index([status, createdAt])
  @@index([orgId, status, createdAt])
}

model ConsultationSessionInviteQuoteLine {
  id          String                         @id @default(cuid())
  quoteId     String
  clinicianId String
  role        ConsultationInviteLineRole
  feeKind     ClinicianFeeKind
  visitMode   AppointmentVisitMode
  specialty   String?
  required    Boolean                        @default(true)
  amountMinor Int
  currency    String                         @db.VarChar(3)
  metadata    Json?
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  orgId       String                         @default("org-default")
  quote       ConsultationSessionInviteQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([clinicianId, createdAt])
  @@index([role, createdAt])
  @@index([orgId, quoteId])
}

model CollaborativeAppointmentDraft {
  id                          String                              @id @default(cuid())
  sourceConsultationSessionId String?
  sourceEncounterId           String?
  appointmentId               String?
  caseId                      String
  patientId                   String
  leadClinicianId             String
  requestedByClinicianId      String
  status                      CollaborativeAppointmentDraftStatus @default(DRAFT)
  visitMode                   AppointmentVisitMode
  startsAt                    DateTime?
  endsAt                      DateTime?
  durationMin                 Int?
  currency                    String                              @db.VarChar(3)
  subtotalMinor               Int                                 @default(0)
  coveredMinor                Int                                 @default(0)
  copayMinor                  Int                                 @default(0)
  totalMinor                  Int                                 @default(0)
  sponsorDecisionJson         Json?
  payloadJson                 Json?
  metadata                    Json?
  approvedAt                  DateTime?
  declinedAt                  DateTime?
  bookedAt                    DateTime?
  expiresAt                   DateTime?
  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @updatedAt
  orgId                       String                              @default("org-default")
  appointment                 Appointment?                        @relation("DraftsFromAppointment", fields: [appointmentId], references: [id])
  sourceConsultationSession   ConsultationSession?                @relation("DraftsFromSession", fields: [sourceConsultationSessionId], references: [id])
  sourceEncounter             Encounter?                          @relation("DraftsFromEncounter", fields: [sourceEncounterId], references: [id])
  lines                       CollaborativeAppointmentDraftLine[]

  @@index([sourceConsultationSessionId, createdAt])
  @@index([sourceEncounterId, createdAt])
  @@index([appointmentId, createdAt])
  @@index([patientId, createdAt])
  @@index([leadClinicianId, createdAt])
  @@index([requestedByClinicianId, createdAt])
  @@index([status, createdAt])
  @@index([orgId, status, createdAt])
}

model CollaborativeAppointmentDraftLine {
  id          String                        @id @default(cuid())
  draftId     String
  clinicianId String
  role        ConsultationInviteLineRole
  feeKind     ClinicianFeeKind
  visitMode   AppointmentVisitMode
  specialty   String?
  required    Boolean                       @default(true)
  amountMinor Int
  currency    String                        @db.VarChar(3)
  metadata    Json?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  orgId       String                        @default("org-default")
  draft       CollaborativeAppointmentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@index([clinicianId, createdAt])
  @@index([role, createdAt])
  @@index([orgId, draftId])
}

model Appointment {
  id          String  @id
  encounterId String
  sessionId   String?
  caseId      String

  clinicianId String
  patientId   String

  hostUserId           String?
  subjectPatientId     String?
  familyRelationshipId String?
  parentAppointmentId  String?

  roomId    String?
  reason    String?
  kind      AppointmentKind      @default(STANDARD)
  visitMode AppointmentVisitMode @default(TELEVISIT)

  startsAt DateTime
  endsAt   DateTime
  status   String

  paymentMethod   AppointmentPaymentMethod?
  paymentStatus   AppointmentPaymentStatus  @default(PENDING)
  paymentIntentId String?
  paymentProvider String?
  paymentRef      String?

  priceCents         Int
  currency           String @default("USD")
  platformFeeCents   Int
  clinicianTakeCents Int

  amountMinor   Int?
  subtotalMinor Int?
  taxMinor      Int?
  discountMinor Int?
  totalMinor    Int?

  clientId                String?
  clientMemberId          String?
  coveragePlanId          String?
  coverageAuthorizationId String?

  coverageDecision       String?
  sponsorAmountMinor     Int?
  patientCopayMinor      Int?
  sponsorCurrency        String? @db.VarChar(3)
  sponsorPricingSnapshot Json?

  bookingSource     String?
  rescheduleCount   Int       @default(0)
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?

  confirmedAt DateTime?
  checkedInAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  meta      Json?
  orgId     String   @default("org-default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounter                Encounter                        @relation(fields: [encounterId], references: [id])
  consultationInviteQuotes ConsultationSessionInviteQuote[]
  collaborativeDrafts      CollaborativeAppointmentDraft[]  @relation("DraftsFromAppointment")

  @@index([clinicianId, startsAt])
  @@index([patientId, startsAt])
  @@index([subjectPatientId, startsAt])
  @@index([status, startsAt])
  @@index([roomId, startsAt])
  @@index([orgId, clinicianId, startsAt])
  @@index([orgId, patientId, startsAt])
  @@index([orgId, subjectPatientId, startsAt])
  @@index([clientId, startsAt])
  @@index([clientMemberId, startsAt])
  @@index([coverageAuthorizationId])
}

model ScheduleBlock {
  id              String   @id @default(cuid())
  clinicianUserId String
  startsAt        DateTime
  endsAt          DateTime
  reason          String?
  createdByUserId String?
  orgId           String   @default("org-default")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clinicianUserId, startsAt, endsAt])
  @@index([orgId, clinicianUserId, startsAt])
}

model NotificationOutbox {
  id              String              @id @default(cuid())
  orgId           String              @default("org-default")
  eventKind       String
  appointmentId   String?
  encounterId     String?
  recipientUserId String?
  recipientEmail  String?
  recipientPhone  String?
  channel         NotificationChannel
  payload         Json
  status          NotificationStatus  @default(PENDING)
  attempts        Int                 @default(0)
  lastError       String?
  scheduledAt     DateTime            @default(now())
  sentAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, scheduledAt])
  @@index([appointmentId])
  @@index([recipientUserId, createdAt])
}

model AppointmentAuditEvent {
  id            String   @id @default(cuid())
  appointmentId String
  action        String
  actorType     String?
  actorUserId   String?
  reason        String?
  beforeJson    Json?
  afterJson     Json?
  createdAt     DateTime @default(now())
  orgId         String   @default("org-default")

  @@index([appointmentId, createdAt])
  @@index([orgId, createdAt])
}

model ClinicianRating {
  id              String           @id @default(cuid())
  clinicianUserId String
  patientId       String
  appointmentId   String?          @unique
  stars           Int
  comment         String?
  orgId           String           @default("org-default")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clinician       ClinicianProfile @relation(fields: [clinicianUserId], references: [userId], onDelete: Cascade)

  @@index([clinicianUserId, createdAt])
  @@index([patientId, createdAt])
}

model ErxOrder {
  id   String @id @default(cuid())
  kind String @default("medication")

  encounterId String
  sessionId   String?
  caseId      String?
  patientId   String
  clinicianId String

  // Human-readable prescription core
  drug         String?
  sig          String?
  dispenseCode String?

  // SA/world-class coding and claims payloads
  meds           Json?
  labTests       Json?
  icd10Codes     Json?
  nappiItems     Json?
  procedureCodes Json?
  tariffCodes    Json?

  patientSnapshot       Json?
  prescriberSnapshot    Json?
  claimsSnapshot        Json?
  pharmacySnapshot      Json?
  authorizationSnapshot Json?

  notes  String?
  status String  @default("queued")

  rxNumber      String?   @unique
  signedAt      DateTime?
  signatureHash String?   @db.VarChar(128)
  version       Int       @default(1)
  voidedAt      DateTime?
  voidReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([patientId])
  @@index([clinicianId])
  @@index([encounterId, status])
  @@index([createdAt])
  @@index([rxNumber])
}

model LabOrder {
  id   String @id @default(cuid())
  kind String @default("lab")

  encounterId String
  sessionId   String?
  caseId      String?
  patientId   String
  clinicianId String

  panel       String
  tests       Json?
  icd10Codes  Json?
  tariffCodes Json?

  patientSnapshot       Json?
  prescriberSnapshot    Json?
  claimsSnapshot        Json?
  labSnapshot           Json?
  authorizationSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("pending")

  encounter Encounter   @relation(fields: [encounterId], references: [id])
  results   LabResult[]

  @@index([patientId])
  @@index([clinicianId])
  @@index([encounterId, status])
  @@index([createdAt])
}

model Payment {
  id          String   @id
  encounterId String
  caseId      String
  amountCents Int
  currency    String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  meta        Json?

  clientId           String?
  billableEventId    String?
  settlementRecordId String?
  payerType          String?
  payerRefId         String?
  providerRef        String? @unique @db.VarChar(160)

  orgId String @default("org-default")

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([status])
  @@index([updatedAt])
  @@index([orgId])
  @@index([clientId])
  @@index([billableEventId])
  @@index([settlementRecordId])
  @@index([providerRef])
}

model Televisit {
  id               String                @id @default(cuid())
  appointmentId    String?
  createdAt        DateTime              @default(now())
  encounterId      String?
  joinClosesAt     DateTime
  joinOpensAt      DateTime
  orgId            String                @default("org-default")
  roomId           String                @unique
  scheduledEndAt   DateTime
  scheduledStartAt DateTime
  status           TelevisitStatus       @default(planned)
  updatedAt        DateTime              @updatedAt
  consents         TelevisitConsent[]
  tickets          TelevisitJoinTicket[]

  @@index([status, scheduledStartAt])
  @@index([roomId, joinOpensAt, joinClosesAt])
  @@index([orgId])
}

model TelevisitJoinTicket {
  id         String        @id @default(cuid())
  visitId    String
  uid        String
  role       TelevisitRole
  tokenHash  String        @unique @db.VarChar(128)
  issuedAt   DateTime      @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  ipHash     String?       @db.VarChar(128)
  userAgent  String?
  orgId      String        @default("org-default")
  visit      Televisit     @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, uid, role])
  @@index([expiresAt])
  @@index([orgId])
}

model TelevisitConsent {
  id             String        @id @default(cuid())
  visitId        String
  uid            String
  role           TelevisitRole
  consentVersion String
  consentDocHash String        @db.VarChar(128)
  scopes         Json
  acceptedAt     DateTime      @default(now())
  locale         String?
  ipHash         String?       @db.VarChar(128)
  userAgent      String?
  orgId          String        @default("org-default")
  visit          Televisit     @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([visitId, uid, role, consentVersion])
  @@index([visitId, uid, role])
  @@index([orgId])
}

model RuntimeEvent {
  id                String   @id @default(cuid())
  ts                BigInt
  kind              String
  encounterId       String?
  patientId         String?
  clinicianId       String?
  targetPatientId   String?
  targetClinicianId String?
  targetAdmin       Boolean? @default(false)
  orgId             String?
  severity          String?
  payload           Json?

  @@index([ts])
  @@index([kind])
  @@index([patientId, ts])
  @@index([encounterId, ts])
  @@index([kind, severity, ts])
  @@index([targetPatientId])
  @@index([targetClinicianId])
  @@index([orgId])
}

model AuthCredential {
  id           String            @id @default(cuid())
  email        String            @unique @db.VarChar(320)
  passwordHash String
  actorType    PresenceActorType @default(PATIENT)
  disabled     Boolean           @default(false)
  orgId        String            @default("org-default")
  lastLoginAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([actorType])
  @@index([orgId])
  @@index([email, disabled])
}

model PasswordResetToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique @db.VarChar(128)
  email         String    @db.VarChar(320)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  requestedByIp String?
  requestedByUa String?
  orgId         String    @default("org-default")

  @@index([email, expiresAt])
  @@index([expiresAt])
  @@index([orgId, createdAt])
}

model AuthOtpChallenge {
  id            String    @id @default(cuid())
  identifier    String    @db.VarChar(320)
  channel       String    @default("email") @db.VarChar(24)
  codeHash      String    @db.VarChar(128)
  purpose       String    @default("login") @db.VarChar(40)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  requestedByIp String?
  requestedByUa String?
  meta          Json?

  @@index([identifier, purpose, expiresAt])
  @@index([expiresAt])
  @@index([createdAt])
}

model UserPasskeyCredential {
  id                 String   @id @default(cuid())
  userId             String
  credentialId       String   @unique
  publicKey          String
  counter            BigInt   @default(0)
  transports         Json?
  deviceLabel        String?
  backedUp           Boolean  @default(false)
  createdAt          DateTime @default(now())
  lastUsedAt         DateTime?
  disabledAt         DateTime?

  @@index([userId])
}

model WebAuthnChallenge {
  id          String   @id @default(cuid())
  userId      String?
  identifier  String?
  challenge   String   @unique
  type        String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, type])
  @@index([identifier, type])
  @@index([expiresAt])
}

model PresenceSession {
  id         String            @id @default(cuid())
  userId     String
  actorType  PresenceActorType
  actorRefId String?
  app        String
  startedAt  DateTime          @default(now())
  lastSeenAt DateTime
  endedAt    DateTime?
  ipCountry  String?
  ipCity     String?
  userAgent  String?
  meta       Json?

  @@index([actorType, lastSeenAt])
  @@index([userId, startedAt])
  @@index([actorType, app, lastSeenAt])
}

model AuditLog {
  id          String         @id @default(cuid())
  createdAt   DateTime       @default(now())
  actorUserId String?
  actorType   AuditActorType
  actorRefId  String?
  app         String
  sessionId   String?
  action      String
  entityType  String?
  entityId    String?
  description String?
  ip          String?
  ipCountry   String?
  ipCity      String?
  userAgent   String?
  meta        Json?

  @@index([createdAt])
  @@index([actorType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model OrgDepartment {
  id           String           @id @default(cuid())
  orgId        String           @default("org-default")
  name         String
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
