# Ambulant+ caption worker
# Server-side only. Do not expose these values to patient-app or clinician-app.

# LiveKit service credentials.
# Use the real production values from the worker runtime environment.
LIVEKIT_URL=
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AWS Transcribe.
# In ECS/Fargate, prefer an IAM task role instead of static AWS keys.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# API Gateway base URL used for transcript persistence.
# API_GATEWAY_URL is preferred; APIGW_BASE_URL/APIGW_BASE/API_GATEWAY_BASE_URL are also accepted.
API_GATEWAY_URL=

CAPTION_WORKER_ID=caption-worker
CAPTION_PROVIDER=aws-transcribe-medical
CAPTION_LANGUAGE=en-US
CAPTION_ENABLE_MEDICAL=true
CAPTION_PERSIST=true
CAPTION_BOT_NAME=AmbulantCaptionWorker
CAPTION_MEDICAL_SPECIALTY=PRIMARYCARE
CAPTION_MEDICAL_TYPE=CONVERSATION

# Must match api-gateway's AMBULANT_INTERNAL_IDENTITY_SECRET for signed internal writes.
AMBULANT_INTERNAL_IDENTITY_SECRET=
